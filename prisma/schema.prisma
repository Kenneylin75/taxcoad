generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PricePlan {
  id           String   @id @default(cuid())
  name         String
  monthlyPrice Int      @default(0) @map("monthly_price")
  annualPrice  Int      @default(0) @map("annual_price")
  features     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  temples      Temple[]

  @@map("price_plans")
}

model Distributor {
  id           String             @id @default(cuid())
  name         String
  status       String             @default("Active")
  setupFee     Int                @default(0)
  monthlyRent  Int                @default(0)
  paymentCycle String             @default("Yearly")
  contactName  String?            @map("contact_name")
  contactPhone String?            @map("contact_phone")
  email        String?
  account      String?
  password     String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at")
  address      String?
  b2bPayment   Json?              @map("b2b_payment_config")
  bankAccount  String?            @map("bank_account")
  bankCode     String?            @map("bank_code")
  bankName     String?            @map("bank_name")
  customNodes  Int?               @default(100) @map("custom_nodes")
  nodes        Int?               @default(100)
  quota        Int?               @default(100)
  temples      Temple[]
  sales        DistributorSales[]

  @@map("distributors")
}

model DistributorSales {
  id              String       @id @default(cuid())
  distributorId   String?      @map("distributor_id")
  name            String
  phone           String?
  status          String       @default("Active")
  setupFee        Int          @default(0)
  monthlyRent     Int          @default(0)
  paymentCycle    String       @default("Yearly")
  role            String?
  account         String?
  password        String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")
  bankAccount     Json?        @map("bank_account_info")
  commissionRules Json?        @map("commission_rules")
  joinedAt        String?      @map("joined_at")
  email           String?
  temples         Temple[]
  commissions     Commission[]
  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  visits          SalesVisit[]

  @@map("dist_sales")
}

model Commission {
  id        String            @id @default(cuid())
  salesId   String?           @map("sales_id")
  amount    Int               @default(0)
  status    String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")
  sales     DistributorSales? @relation(fields: [salesId], references: [id])

  @@map("commissions")
}

model SalesVisit {
  id         String            @id @default(cuid())
  salesId    String?           @map("sales_id")
  templeName String?           @map("temple_name")
  content    String?
  date       String?
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")
  salesName  String?           @map("sales_name")
  sales      DistributorSales? @relation(fields: [salesId], references: [id])

  @@map("sales_visits")
}

model DistributorApplication {
  id             String   @id @default(cuid())
  name           String?
  status         String   @default("Pending")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  submittedBy    String?  @map("submitted_by")
  account        String?
  address        String?
  contactName    String?  @map("contact_name")
  email          String?
  expirationDate String?  @map("expiration_date")
  nodes          Int?
  password       String?
  phone          String?
  planId         String?  @map("plan_id")
  price          Int?
  rejectReason   String?  @map("reject_reason")
  rejectedAt     String?  @map("rejected_at")
  taxId          String?  @map("tax_id")

  @@map("distributor_applications")
}

model SuperSalesOverride {
  id           String   @id @default(cuid())
  ruleName     String?  @map("rule_name")
  overrideData Json?    @map("override_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("super_sales_overrides")
}

model Temple {
  id                  String               @id @default(cuid())
  name                String
  account             String?
  password            String?
  region              String?
  city                String?
  address             String?
  phone               String?
  status              String               @default("Active")
  createdAt           DateTime             @default(now()) @map("created_at")
  distributorId       String?              @map("distributor_id")
  monthlyRent         Int                  @default(0) @map("monthly_rent")
  paymentCycle        String               @default("Yearly") @map("payment_cycle")
  planId              String?              @map("plan_id")
  salesId             String?              @map("sales_id")
  setupFee            Int                  @default(0) @map("setup_fee")
  superSalesId        String?              @map("super_sales_id")
  templeName          String?              @map("temple_name")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  email               String?
  analyticsData       Json?                @map("analytics_data")
  bannerUrl           String?              @map("banner_url")
  guestSettings       Json?                @map("guest_settings")
  logoUrl             String?              @map("logo_url")
  themeColor          String?              @map("theme_color")
  lineChannelSecret   String?              @map("line_channel_secret")
  lineChannelToken    String?              @map("line_channel_token")
  lineLoginClientId   String?              @map("line_login_client_id")
  linePushEnabled     Boolean?             @default(false) @map("line_push_enabled")
  formTemplates       Json?                @map("form_templates")
  aiTokens            Int                  @default(5000) @map("ai_tokens")
  billingStartDate    DateTime?            @map("billing_start_date")
  freeType            String?              @default("Normal") @map("free_type")
  trialMonths         Int?                 @default(0) @map("trial_months")
  distributor         Distributor?         @relation(fields: [distributorId], references: [id])
  plan                PricePlan?           @relation(fields: [planId], references: [id])
  sales               DistributorSales?    @relation(fields: [salesId], references: [id])
  templeBills         TempleBill[]
  users               User[]
  activities          Activity[]
  adminNotifs         AdminNotification[]
  aiChatLogs          AiChatLog[]
  appointments        Appointment[]
  auditLogs           AuditLog[]
  deepRecords         DeepRecord[]
  eventRegistrations  EventRegistration[]
  events              Event[]
  financeRecords      FinanceRecord[]
  forms               Form[]
  guests              Guest[]
  lampCategories      LampCategory[]
  lampRecords         LampRecord[]
  leaveRecords        LeaveRecord[]
  printTemplates      PrintTemplate[]
  queueEvents         QueueEvent[]
  queueTickets        QueueTicket[]
  serviceSettings     ServiceSetting[]
  services            Service[]
  slots               Slot[]
  syncQueues          SyncQueue[]
  aiUsages            TempleAiUsage[]
  templeNotifications TempleNotification[]
  paymentConfig       TemplePaymentConfig?
  templeStorages      TempleStorage?
}

model TempleApplication {
  id            String   @id @default(cuid())
  status        String   @default("Pending")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  contactPerson String?  @map("contact_person")
  contactPhone  String?  @map("contact_phone")
  monthlyFee    Int      @map("monthly_fee")
  planId        String   @map("plan_id")
  salesId       String?  @map("sales_id")
  setupFee      Int      @map("setup_fee")
  templeName    String   @map("temple_name")

  @@map("temple_applications")
}

model TempleBill {
  id          String   @id @default(cuid())
  type        String?
  amount      Int      @default(0)
  status      String   @default("Unpaid")
  timestamp   String?
  billingDate String?  @map("billing_date")
  createdAt   DateTime @default(now()) @map("created_at")
  dueDate     String?  @map("due_date")
  itemName    String?  @map("item_name")
  payeeId     String?  @map("payee_id")
  payeeRole   String?  @map("payee_role")
  templeId    String   @map("temple_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  receiptUrl  String?  @map("receipt_url")
  temple      Temple   @relation(fields: [templeId], references: [id])
}

model StoragePlan {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  sizeGb       Int      @map("size_gb")

  @@map("storage_plans")
}

model TempleStorage {
  id             String   @id @default(cuid())
  templeId       String   @unique @map("temple_id")
  usedBytes      BigInt   @default(0) @map("used_bytes")
  planId         String?  @map("plan_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  allocatedBytes BigInt   @default(5368709120) @map("allocated_bytes")
  city           String?
  planName       String?  @map("plan_name")
  temple         Temple   @relation(fields: [templeId], references: [id])

  @@map("temple_storages")
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  account      String?
  password     String?
  name         String
  role         String
  phone        String?
  status       String   @default("Active")
  permissions  Json?
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  monthlyRent  Int      @default(0) @map("monthly_rent")
  paymentCycle String   @default("Yearly") @map("payment_cycle")
  setupFee     Int      @default(0) @map("setup_fee")
  templeId     String?  @map("temple_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  email        String?
  temple       Temple?  @relation(fields: [templeId], references: [id])
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  account      String?
  password     String?
  role         String?
  status       String   @default("Active")
  setupFee     Int      @default(0)
  monthlyRent  Int      @default(0)
  paymentCycle String   @default("Yearly")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admins")
}

model AdminLog {
  id          String   @id @default(cuid())
  adminId     String?  @map("admin_id")
  adminName   String?  @map("admin_name")
  action      String?
  target      String?
  details     String?
  timestamp   String?
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admin_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String?
  details     String?
  timestamp   String?
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  operator    String?
  templeId    String   @map("temple_id")
  temple      Temple   @relation(fields: [templeId], references: [id])

  @@map("audit_logs")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_config")
}

model Guest {
  id                  String               @id @default(cuid())
  templeId            String               @map("temple_id")
  phone               String
  name                String
  gender              String?
  birthday            String?
  lunarBirthday       String?              @map("lunar_birthday")
  birthHour           String?              @map("birth_hour")
  address             String?
  avatar              String?
  lineId              String?              @map("line_id")
  email               String?
  password            String?
  status              String               @default("Active")
  setupFee            Int                  @default(0)
  monthlyRent         Int                  @default(0)
  paymentCycle        String               @default("Yearly")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  account             String?
  activities          Activity[]
  adminNotifs         AdminNotification[]
  appointments        Appointment[]
  deepRecords         DeepRecord[]
  eventRegs           EventRegistration[]
  guestFiles          GuestFile[]
  guestNotes          GuestNote[]
  temple              Temple               @relation(fields: [templeId], references: [id])
  lampRecords         LampRecord[]
  queueTickets        QueueTicket[]
  templeNotifications TempleNotification[]

  @@unique([templeId, phone])
  @@map("guests")
}

model GuestNote {
  id        String   @id @default(cuid())
  templeId  String   @map("temple_id")
  guestId   String   @map("guest_id")
  phone     String?
  title     String
  content   String
  date      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([templeId, guestId])
  @@map("guest_notes")
}

model GuestFile {
  id         String   @id @default(cuid())
  guestId    String?  @map("guest_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  folder     String?
  name       String?
  phone      String?
  templeId   String   @map("temple_id")
  type       String?
  uploadedBy String?  @map("uploaded_by")
  url        String?
  guest      Guest?   @relation(fields: [guestId], references: [id])

  @@map("guest_files")
}

model DeepRecord {
  id         String   @id @default(cuid())
  phone      String?
  category   String?
  content    String?
  date       String?
  paymentRef String?  @map("payment_ref")
  remarks    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  guestId    String?  @map("guest_id")
  templeId   String   @map("temple_id")
  guest      Guest?   @relation(fields: [guestId], references: [id])
  temple     Temple   @relation(fields: [templeId], references: [id])

  @@map("deep_records")
}

model Activity {
  id        String   @id @default(cuid())
  templeId  String   @map("temple_id")
  guestId   String?  @map("guest_id")
  phone     String?
  type      String?
  content   String?
  timestamp String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  guest     Guest?   @relation(fields: [guestId], references: [id])
  temple    Temple   @relation(fields: [templeId], references: [id])

  @@map("activities")
}

model Service {
  id                    String        @id @default(cuid())
  templeId              String        @map("temple_id")
  name                  String
  price                 Int           @default(0)
  duration              String?
  description           String?
  status                String        @default("Active")
  setupFee              Int           @default(0)
  monthlyRent           Int           @default(0)
  paymentCycle          String        @default("Yearly")
  assignedStaff         Json?         @map("assigned_staff")
  color                 String?
  linkedFormId          String?       @map("linked_form_id")
  linkedPrintTemplateId String?       @map("linked_print_template_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at")
  appointments          Appointment[]
  temple                Temple        @relation(fields: [templeId], references: [id])
  slots                 Slot[]

  @@map("services")
}

model ServiceSetting {
  id                String   @id @default(cuid())
  templeId          String   @map("temple_id")
  pushConfigs       Json?    @map("push_configs")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  allowCancel       Boolean? @default(true) @map("allow_cancel")
  allowModify       Boolean? @default(true) @map("allow_modify")
  cancelHoursBefore Int?     @map("cancel_hours_before")
  modifyHoursBefore Int?     @map("modify_hours_before")
  modules           Json?    @map("modules")
  temple            Temple   @relation(fields: [templeId], references: [id])

  @@map("service_settings")
}

model PrintTemplate {
  id                String   @id @default(cuid())
  templeId          String   @map("temple_id")
  name              String
  templeName        String?  @map("temple_name")
  watermarkUrl      String?  @map("watermark_url")
  watermarkOpacity  Float?   @map("watermark_opacity")
  borderStyle       String?  @map("border_style")
  content           Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  watermarkLocalUrl String?  @map("watermark_local_url")
  temple            Temple   @relation(fields: [templeId], references: [id])

  @@map("print_templates")
}

model Form {
  id        String   @id @default(cuid())
  templeId  String   @map("temple_id")
  name      String
  fields    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  temple    Temple   @relation(fields: [templeId], references: [id])

  @@map("forms")
}

model TemplePaymentConfig {
  id             String   @id @default(cuid())
  templeId       String   @unique @map("temple_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  cash           Json     @default("{}")
  customQR       Json     @default("{}") @map("custom_qr")
  customTransfer Json     @default("{}") @map("custom_transfer")
  linePay        Json     @default("{}") @map("line_pay")
  thirdParty     Json     @default("{}") @map("third_party")
  temple         Temple   @relation(fields: [templeId], references: [id])

  @@map("temple_payment_configs")
}

model Slot {
  id             String   @id @default(cuid())
  templeId       String   @map("temple_id")
  date           String?
  time           String?
  staff          String?
  description    String?
  location       String?
  boundServiceId String?  @map("bound_service_id")
  price          Int      @default(0)
  status         String   @default("Available")
  guestName      String?  @map("guest_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  batchId        String?  @map("batch_id")
  service        Service? @relation(fields: [boundServiceId], references: [id])
  temple         Temple   @relation(fields: [templeId], references: [id])

  @@map("slots")
}

model Appointment {
  id              String   @id @default(cuid())
  templeId        String   @map("temple_id")
  guestId         String?  @map("guest_id")
  guestName       String?  @map("guest_name")
  phone           String?
  service         String?
  serviceId       String?  @map("service_id")
  date            String?
  time            String?
  staff           String?
  amount          Int      @default(0)
  paymentMethod   String?  @map("payment_method")
  paymentStatus   String   @default("Pending") @map("payment_status")
  paymentRef      String?  @map("payment_ref")
  paymentProofUrl String?  @map("payment_proof_url")
  remarks         String?
  status          String   @default("Pending")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  guest           Guest?   @relation(fields: [guestId], references: [id])
  serviceRef      Service? @relation(fields: [serviceId], references: [id])
  temple          Temple   @relation(fields: [templeId], references: [id])

  @@map("appointments")
}

model LampCategory {
  id           String       @id @default(cuid())
  templeId     String       @map("temple_id")
  name         String
  description  String?
  price        Int          @default(0)
  durationDays Int          @default(365) @map("duration_days")
  totalSlots   Int          @default(500) @map("total_slots")
  precautions  String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")
  temple       Temple       @relation(fields: [templeId], references: [id])
  records      LampRecord[]

  @@map("lamp_categories")
}

model LampRecord {
  id              String        @id @default(cuid())
  templeId        String        @map("temple_id")
  categoryId      String?       @map("category_id")
  categoryName    String?       @map("category_name")
  guestId         String?       @map("guest_id")
  guestName       String?       @map("guest_name")
  phone           String?
  applicantName   String?       @map("applicant_name")
  applicantBirth  String?       @map("applicant_birth")
  actualPrice     Int           @default(0) @map("actual_price")
  paymentMethod   String?       @map("payment_method")
  paymentStatus   String        @default("Pending") @map("payment_status")
  paymentProofUrl String?       @map("payment_proof_url")
  remarks         String?
  status          String        @default("Pending")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  durationDays    Int           @default(365) @map("duration_days")
  position        String?
  startDate       DateTime?     @map("start_date")
  expiryDate      DateTime?     @map("expiry_date")
  paymentRef      String?       @map("payment_ref")
  category        LampCategory? @relation(fields: [categoryId], references: [id])
  guest           Guest?        @relation(fields: [guestId], references: [id])
  temple          Temple        @relation(fields: [templeId], references: [id])

  @@map("lamp_records")
}

model Event {
  id            String              @id @default(cuid())
  templeId      String              @map("temple_id")
  title         String
  date          String?
  location      String?
  description   String?
  imageUrl      String?             @map("image_url")
  bannerUrl     String?             @map("banner_url")
  price         Int                 @default(0)
  capacity      Int                 @default(0)
  fields        Json?
  status        String              @default("Draft")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")
  precautions   String?
  registrations EventRegistration[]
  temple        Temple              @relation(fields: [templeId], references: [id])

  @@map("events")
}

model EventRegistration {
  id               String   @id @default(cuid())
  templeId         String?  @map("temple_id")
  eventId          String?  @map("event_id")
  guestId          String?  @map("guest_id")
  guestName        String?  @map("guest_name")
  phone            String?
  actualPrice      Int      @default(0) @map("actual_price")
  paymentMethod    String?  @map("payment_method")
  paymentStatus    String   @default("Pending") @map("payment_status")
  paymentProofUrl  String?  @map("payment_proof_url")
  paymentRef       String?  @map("payment_ref")
  remarks          String?
  registrationData Json?    @map("registration_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  event            Event?   @relation(fields: [eventId], references: [id])
  guest            Guest?   @relation(fields: [guestId], references: [id])
  temple           Temple?  @relation(fields: [templeId], references: [id])

  @@map("event_registrations")
}

model QueueEvent {
  id          String        @id @default(cuid())
  templeId    String        @map("temple_id")
  title       String
  date        String?
  startTime   String?       @map("start_time")
  endTime     String?       @map("end_time")
  location    String?
  serviceType String?       @map("service_type")
  price       Int           @default(0)
  maxCapacity Int           @default(0) @map("max_capacity")
  status      String        @default("Draft")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")
  description String?
  temple      Temple        @relation(fields: [templeId], references: [id])
  tickets     QueueTicket[]

  @@map("queue_events")
}

model QueueTicket {
  id               String      @id @default(cuid())
  templeId         String?     @map("temple_id")
  eventId          String?     @map("event_id")
  guestId          String?     @map("guest_id")
  guestName        String?     @map("guest_name")
  phone            String?
  displayNum       String?     @map("display_num")
  paymentRef       String?     @map("payment_ref")
  remarks          String?
  actualOrder      Int         @default(0) @map("actual_order")
  status           String      @default("Queuing")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")
  assignedNumber   String?     @map("assigned_number")
  eventTitle       String?     @map("event_title")
  paymentStatus    String?     @map("payment_status")
  paymentMethod    String?     @map("payment_method")
  paymentProofUrl  String?     @map("payment_proof_url")
  paymentUpdatedAt DateTime?   @map("payment_updated_at")
  queueEvent       QueueEvent? @relation(fields: [eventId], references: [id])
  guest            Guest?      @relation(fields: [guestId], references: [id])
  temple           Temple?     @relation(fields: [templeId], references: [id])

  @@map("queue_tickets")
}

