// =====================================================================
// 全方位雲端宮廟管理系統 - Prisma 資料庫綱要 (Expanded Full Schema)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// SaaS Core (租戶與經銷商)
// ---------------------------------------------------------------------

model PricePlan {
  id           String   @id @default(cuid())
  name         String
  monthlyPrice Int      @default(0) @map("monthly_price")
  annualPrice  Int      @default(0) @map("annual_price")
  features     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  temples      Temple[]

  @@map("price_plans")
}

model Distributor {
  id           String   @id @default(cuid())
  name         String
  status        String   @default("Active")
  setupFee      Int      @default(0)
  monthlyRent   Int      @default(0)
  paymentCycle  String   @default("Yearly")
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  email        String?
  account      String?
  password     String?
  address      String?
  bankCode     String?  @map("bank_code")
  bankAccount  String?  @map("bank_account")
  bankName     String?  @map("bank_name")
  b2bPayment   Json?    @map("b2b_payment_config")
  quota        Int?     @default(100)
  nodes        Int?     @default(100)
  customNodes  Int?     @default(100) @map("custom_nodes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sales   DistributorSales[]
  temples Temple[]

  @@map("distributors")
}

model DistributorSales {
  id            String   @id @default(cuid())
  distributorId String?  @map("distributor_id")
  name          String
  phone         String?
  email         String?
  status        String   @default("Active")
  setupFee      Int      @default(0)
  monthlyRent   Int      @default(0)
  paymentCycle  String   @default("Yearly")
  role          String?
  account       String?
  password      String?
  bankAccount   Json?    @map("bank_account_info")
  commissionRules Json?  @map("commission_rules")
  joinedAt      String?  @map("joined_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  distributor Distributor? @relation(fields: [distributorId], references: [id])
  commissions Commission[]
  visits      SalesVisit[]

  @@map("dist_sales")
}

model Commission {
  id        String   @id @default(cuid())
  salesId   String?  @map("sales_id")
  amount    Int      @default(0)
  status    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sales DistributorSales? @relation(fields: [salesId], references: [id])

  @@map("commissions")
}

model SalesVisit {
  id         String   @id @default(cuid())
  salesId    String?  @map("sales_id")
  templeName String?  @map("temple_name")
  salesName  String?  @map("sales_name")
  content    String?
  date       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sales DistributorSales? @relation(fields: [salesId], references: [id])

  @@map("sales_visits")
}

model DistributorApplication {
  id          String   @id @default(cuid())
  name        String?
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  taxId       String?  @map("tax_id")
  address     String?
  planId      String?  @map("plan_id")
  price       Int?
  nodes       Int?
  account     String?
  password    String?
  expirationDate String? @map("expiration_date")
  rejectReason String? @map("reject_reason")
  rejectedAt   String? @map("rejected_at")
  status      String   @default("Pending")
  submittedBy String?  @map("submitted_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("distributor_applications")
}

model SuperSalesOverride {
  id           String   @id @default(cuid())
  ruleName     String?  @map("rule_name")
  overrideData Json?    @map("override_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("super_sales_overrides")
}

// ---------------------------------------------------------------------
// 核心系統 (Temple Core)
// ---------------------------------------------------------------------

model Temple {
  id            String   @id @default(cuid())
  name          String
  templeName    String?  @map("temple_name")
  account       String?
  password      String?
  region        String?
  city          String?
  address       String?
  phone         String?
  email         String?
  status        String   @default("Active")
  setupFee      Int      @default(0) @map("setup_fee")
  monthlyRent   Int      @default(0) @map("monthly_rent")
  paymentCycle  String   @default("Yearly") @map("payment_cycle")
  distributorId String?  @map("distributor_id")
  salesId       String?  @map("sales_id")
  superSalesId  String?  @map("super_sales_id")
  planId        String?  @map("plan_id")
  themeColor    String?  @map("theme_color")
  logoUrl       String?  @map("logo_url")
  bannerUrl     String?  @map("banner_url")
  analyticsData Json?    @map("analytics_data")
  guestSettings Json?    @map("guest_settings")
  lineChannelToken   String?  @map("line_channel_token")
  lineChannelSecret  String?  @map("line_channel_secret")
  lineLoginClientId  String?  @map("line_login_client_id")
  linePushEnabled    Boolean? @default(false) @map("line_push_enabled")
  formTemplates      Json?    @map("form_templates")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  distributor Distributor? @relation(fields: [distributorId], references: [id])
  plan        PricePlan?   @relation(fields: [planId], references: [id])

  users               User[]
  guests              Guest[]
  leaveRecords        LeaveRecord[]
  appointments        Appointment[]
  deepRecords         DeepRecord[]
  activities          Activity[]
  auditLogs           AuditLog[]
  paymentConfig       TemplePaymentConfig?
  events              Event[]
  eventRegistrations  EventRegistration[]
  lampCategories      LampCategory[]
  lampRecords         LampRecord[]
  queueEvents         QueueEvent[]
  queueTickets        QueueTicket[]
  adminNotifs         AdminNotification[]
  services            Service[]
  serviceSettings     ServiceSetting[]
  printTemplates      PrintTemplate[]
  forms               Form[]
  slots               Slot[]
  templeBills         TempleBill[]
  templeStorages      TempleStorage[]
  aiUsages            TempleAiUsage[]
  syncQueues          SyncQueue[]
  financeRecords      FinanceRecord[]
  templeNotifications TempleNotification[]
  aiChatLogs          AiChatLog[]
}

model TempleApplication {
  id            String   @id @default(cuid())
  templeName    String   @map("temple_name")
  contactPerson String?  @map("contact_person")
  contactPhone  String?  @map("contact_phone")
  planId        String   @map("plan_id")
  setupFee      Int      @map("setup_fee")
  monthlyFee    Int      @map("monthly_fee")
  status        String   @default("Pending")
  salesId       String?  @map("sales_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("temple_applications")
}

model TempleBill {
  id          String   @id @default(cuid())
  templeId    String   @map("temple_id")
  type        String?
  itemName    String?  @map("item_name")
  amount      Int      @default(0)
  status      String   @default("Unpaid")
  dueDate     String?  @map("due_date")
  billingDate String?  @map("billing_date")
  payeeRole   String?  @map("payee_role")
  payeeId     String?  @map("payee_id")
  timestamp   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])
}

model StoragePlan {
  id           String   @id @default(cuid())
  sizeGb       Int      @map("size_gb")
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("storage_plans")
}

model TempleStorage {
  id             String   @id @default(cuid())
  templeId       String   @map("temple_id") @unique
  usedBytes      BigInt   @default(0) @map("used_bytes")
  allocatedBytes BigInt   @default(5368709120) @map("allocated_bytes")
  planName       String?  @map("plan_name")
  city           String?
  planId         String?  @map("plan_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])

  @@map("temple_storages")
}

// ---------------------------------------------------------------------
// 系統人員 (Users & Admins)
// ---------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  username    String?  @unique
  account     String?
  password    String?
  name        String
  role        String
  templeId    String?  @map("temple_id")
  phone       String?
  email       String?
  status        String   @default("Active")
  setupFee      Int      @default(0) @map("setup_fee")
  monthlyRent   Int      @default(0) @map("monthly_rent")
  paymentCycle  String   @default("Yearly") @map("payment_cycle")
  permissions Json?
  avatar      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple? @relation(fields: [templeId], references: [id])
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  account   String?
  password  String?
  role      String?
  status        String   @default("Active")
  setupFee      Int      @default(0)
  monthlyRent   Int      @default(0)
  paymentCycle  String   @default("Yearly")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admins")
}

model AdminLog {
  id          String   @id @default(cuid())
  adminId     String?  @map("admin_id")
  adminName   String?  @map("admin_name")
  action      String?
  target      String?
  details     String?
  timestamp   String?
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admin_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  templeId    String   @map("temple_id")
  action      String?
  details     String?
  operator    String?
  timestamp   String?
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])
  @@map("audit_logs")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_config")
}

// ---------------------------------------------------------------------
// 信眾管理 (CRM)
// ---------------------------------------------------------------------

model Guest {
  id            String   @id @default(cuid())
  templeId      String   @map("temple_id")
  phone         String
  name          String
  gender        String?
  birthday      String?
  lunarBirthday String?  @map("lunar_birthday")
  birthHour     String?  @map("birth_hour")
  address       String?
  avatar        String?
  lineId        String?  @map("line_id")
  email         String?
  password      String?
  status        String   @default("Active")
  setupFee      Int      @default(0)
  monthlyRent   Int      @default(0)
  paymentCycle  String   @default("Yearly")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple       Temple              @relation(fields: [templeId], references: [id])
  appointments Appointment[]
  lampRecords  LampRecord[]
  eventRegs    EventRegistration[]
  queueTickets QueueTicket[]
  adminNotifs  AdminNotification[]
  guestFiles   GuestFile[]
  deepRecords  DeepRecord[]
  activities   Activity[]
  templeNotifications TempleNotification[]

  @@unique([templeId, phone])
  @@map("guests")
}

model GuestFile {
  id         String   @id @default(cuid())
  templeId   String   @map("temple_id")
  guestId    String?  @map("guest_id")
  phone      String?
  url        String?
  type       String?
  name       String?
  folder     String?
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  guest Guest? @relation(fields: [guestId], references: [id])

  @@map("guest_files")
}

model DeepRecord {
  id         String   @id @default(cuid())
  templeId   String   @map("temple_id")
  guestId    String?  @map("guest_id")
  phone      String?
  category   String?
  content    String?
  date       String?
  paymentRef String?  @map("payment_ref")
  remarks    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  guest      Guest?   @relation(fields: [guestId], references: [id])
  temple     Temple   @relation(fields: [templeId], references: [id])
  @@map("deep_records")
}

model Activity {
  id        String   @id @default(cuid())
  templeId  String   @map("temple_id")
  guestId   String?  @map("guest_id")
  phone     String?
  type      String?
  content   String?
  timestamp String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  guest     Guest?   @relation(fields: [guestId], references: [id])
  temple    Temple   @relation(fields: [templeId], references: [id])
  @@map("activities")
}

// ---------------------------------------------------------------------
// 服務設定與表單 (Services & Forms)
// ---------------------------------------------------------------------

model Service {
  id                    String   @id @default(cuid())
  templeId              String   @map("temple_id")
  name                  String
  price                 Int      @default(0)
  duration              String?
  description           String?
  status        String   @default("Active")
  setupFee      Int      @default(0)
  monthlyRent   Int      @default(0)
  paymentCycle  String   @default("Yearly")
  assignedStaff         Json?    @map("assigned_staff")
  color                 String?
  linkedFormId          String?  @map("linked_form_id")
  linkedPrintTemplateId String?  @map("linked_print_template_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])
  slots         Slot[]
  appointments  Appointment[]

  @@map("services")
}

model ServiceSetting {
  id                String   @id @default(cuid())
  templeId          String   @map("temple_id")
  pushConfigs       Json?    @map("push_configs")
  cancelHoursBefore Int?     @map("cancel_hours_before")
  modifyHoursBefore Int?     @map("modify_hours_before")
  allowCancel       Boolean? @default(true) @map("allow_cancel")
  allowModify       Boolean? @default(true) @map("allow_modify")
  modules           Json?    @map("modules")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])

  @@map("service_settings")
}

model PrintTemplate {
  id               String   @id @default(cuid())
  templeId         String   @map("temple_id")
  name             String
  templeName       String?  @map("temple_name")
  watermarkUrl     String?  @map("watermark_url")
  watermarkLocalUrl String? @map("watermark_local_url")
  watermarkOpacity Float?   @map("watermark_opacity")
  borderStyle      String?  @map("border_style")
  content          Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])

  @@map("print_templates")
}

model Form {
  id        String   @id @default(cuid())
  templeId  String   @map("temple_id")
  name      String
  fields    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])

  @@map("forms")
}

model TemplePaymentConfig {
  id             String   @id @default(cuid())
  templeId       String   @unique @map("temple_id")
  linePay        Json     @default("{}") @map("line_pay")
  thirdParty     Json     @default("{}") @map("third_party")
  customTransfer Json     @default("{}") @map("custom_transfer")
  customQR       Json     @default("{}") @map("custom_qr")
  cash           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])

  @@map("temple_payment_configs")
}

// ---------------------------------------------------------------------
// 預約與排程 (Appointments & Slots)
// ---------------------------------------------------------------------

model Slot {
  id             String   @id @default(cuid())
  templeId       String   @map("temple_id")
  date           String?
  time           String?
  staff          String?
  description    String?
  location       String?
  boundServiceId String?  @map("bound_service_id")
  price          Int      @default(0)
  status         String   @default("Available")
  guestName      String?  @map("guest_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])
  service Service? @relation(fields: [boundServiceId], references: [id])

  @@map("slots")
}

model Appointment {
  id              String   @id @default(cuid())
  templeId        String   @map("temple_id")
  guestId         String?  @map("guest_id")
  guestName       String?  @map("guest_name")
  phone           String?
  service         String?
  serviceId       String?  @map("service_id")
  date            String?
  time            String?
  staff           String?
  amount          Int      @default(0)
  paymentMethod   String?  @map("payment_method")
  paymentStatus   String   @default("Pending") @map("payment_status")
  paymentRef      String?  @map("payment_ref")
  paymentProofUrl String?  @map("payment_proof_url")
  remarks         String?
  status          String   @default("Pending")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id])
  guest  Guest? @relation(fields: [guestId], references: [id])
  serviceRef Service? @relation(fields: [serviceId], references: [id])

  @@map("appointments")
}

// ---------------------------------------------------------------------
// 點燈系統 (Lamp Lighting)
// ---------------------------------------------------------------------

model LampCategory {
  id           String   @id @default(cuid())
  templeId     String   @map("temple_id")
  name         String
  description  String?
  price        Int      @default(0)
  durationDays Int      @default(365) @map("duration_days")
  totalSlots   Int      @default(500) @map("total_slots")
  precautions  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple  Temple       @relation(fields: [templeId], references: [id])
  records LampRecord[]

  @@map("lamp_categories")
}

model LampRecord {
  id              String   @id @default(cuid())
  templeId        String   @map("temple_id")
  categoryId      String?  @map("category_id")
  categoryName    String?  @map("category_name")
  guestId         String?  @map("guest_id")
  guestName       String?  @map("guest_name")
  phone           String?
  applicantName   String?  @map("applicant_name")
  applicantBirth  String?  @map("applicant_birth")
  actualPrice     Int      @default(0) @map("actual_price")
  paymentMethod   String?  @map("payment_method")
  paymentStatus   String   @default("Pending") @map("payment_status")
  paymentRef      String?  @map("payment_ref")
  paymentProofUrl String?  @map("payment_proof_url")
  remarks         String?
  position        String?
  startDate       DateTime? @map("start_date")
  durationDays    Int      @default(365) @map("duration_days")
  expiryDate      DateTime? @map("expiry_date")
  status          String   @default("Pending")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple   Temple        @relation(fields: [templeId], references: [id])
  category LampCategory? @relation(fields: [categoryId], references: [id])
  guest    Guest?        @relation(fields: [guestId], references: [id])

  @@map("lamp_records")
}

// ---------------------------------------------------------------------
// 法會活動 (Events)
// ---------------------------------------------------------------------

model Event {
  id          String   @id @default(cuid())
  templeId    String   @map("temple_id")
  title       String
  date        String?
  location    String?
  description String?
  imageUrl    String?  @map("image_url")
  bannerUrl   String?  @map("banner_url")
  price       Int      @default(0)
  capacity    Int      @default(0)
  fields      Json?
  status      String   @default("Draft")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple        Temple              @relation(fields: [templeId], references: [id])
  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id               String   @id @default(cuid())
  templeId         String?  @map("temple_id")
  eventId          String?  @map("event_id")
  guestId          String?  @map("guest_id")
  guestName        String?  @map("guest_name")
  phone            String?
  actualPrice      Int      @default(0) @map("actual_price")
  paymentMethod    String?  @map("payment_method")
  paymentStatus    String   @default("Pending") @map("payment_status")
  paymentProofUrl  String?  @map("payment_proof_url")
  paymentRef       String?  @map("payment_ref")
  remarks          String?
  registrationData Json?    @map("registration_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  event Event? @relation(fields: [eventId], references: [id])
  guest Guest? @relation(fields: [guestId], references: [id])
  temple Temple? @relation(fields: [templeId], references: [id])

  @@map("event_registrations")
}

// ---------------------------------------------------------------------
// 現場排隊 (Queue System)
// ---------------------------------------------------------------------

model QueueEvent {
  id          String   @id @default(cuid())
  templeId    String   @map("temple_id")
  title       String
  date        String?
  startTime   String?  @map("start_time")
  endTime     String?  @map("end_time")
  location    String?
  serviceType String?  @map("service_type")
  price       Int      @default(0)
  maxCapacity Int      @default(0) @map("max_capacity")
  status      String   @default("Draft")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  temple  Temple        @relation(fields: [templeId], references: [id])
  tickets QueueTicket[]

  @@map("queue_events")
}

model QueueTicket {
  id          String   @id @default(cuid())
  templeId    String?  @map("temple_id")
  eventId     String?  @map("event_id")
  guestId     String?  @map("guest_id")
  guestName   String?  @map("guest_name")
  phone         String?
  eventTitle    String?  @map("event_title")
  displayNum    String?  @map("display_num")
  assignedNumber String? @map("assigned_number")
  paymentStatus String?  @map("payment_status")
  paymentRef    String?  @map("payment_ref")
  remarks       String?
  actualOrder   Int      @default(0) @map("actual_order")
  status        String   @default("Queuing")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  queueEvent QueueEvent? @relation(fields: [eventId], references: [id])
  guest      Guest?      @relation(fields: [guestId], references: [id])
  temple     Temple?     @relation(fields: [templeId], references: [id])

  @@map("queue_tickets")
}

